---
import Squiggle from './Squiggle.astro';
/** Título de sección: Fraunces itálica + rosa, con squiggle opcional. */
interface Props {
  i18nKey: string;       // ej: "perfil.title"
  text: string;          // texto ES por defecto (server-render)
  eyebrow?: string;      // pequeño rótulo arriba
  eyebrowKey?: string;
  squiggle?: boolean;
  align?: 'left' | 'center';
  id?: string;
}
const {
  i18nKey,
  text,
  eyebrow,
  eyebrowKey,
  squiggle = true,
  align = 'left',
  id,
} = Astro.props;
const alignCls = align === 'center' ? 'items-center text-center' : 'items-start text-left';
---
<header class={`flex flex-col gap-3 ${alignCls}`} data-reveal id={id}>
  {eyebrow && (
    <span
      class="text-xs font-semibold uppercase tracking-[0.22em] text-salvia"
      {...(eyebrowKey ? { 'data-i18n': eyebrowKey } : {})}
    >{eyebrow}</span>
  )}
  <h2 class="title-script text-4xl sm:text-5xl lg:text-6xl" data-i18n={i18nKey}>{text}</h2>
  {squiggle && <Squiggle variant="underline" width="160" class="mt-1" />}
</header>
