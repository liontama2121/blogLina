---
/** Título de sección: display sans, tinta. Entradilla opcional debajo (apilada, máx 60ch). */
interface Props {
  i18nKey: string;
  text: string;
  lead?: string;
  leadKey?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  id?: string;
}
const { i18nKey, text, lead, leadKey, align = 'left', as: Tag = 'h2', id } = Astro.props;
const alignCls = align === 'center' ? 'items-center text-center' : 'items-start text-left';
---
<header class={`flex flex-col gap-4 ${alignCls}`} data-reveal id={id}>
  <Tag class="display-lg text-tinta" data-i18n={i18nKey}>{text}</Tag>
  {lead && <p class="lead" {...(leadKey ? { 'data-i18n': leadKey } : {})}>{lead}</p>}
</header>
