---
/** Toggle ES/EN: el comportamiento vive en scripts/i18n-client.ts. */
---
<div
  class="inline-flex items-center rounded-full border border-tinta/20 p-0.5 text-xs font-bold"
  role="group"
  aria-label="Idioma / Language"
>
  <button type="button" data-lang-btn="es" class="lang-btn rounded-full px-3 py-1.5 transition-colors" aria-pressed="true">ES</button>
  <button type="button" data-lang-btn="en" class="lang-btn rounded-full px-3 py-1.5 transition-colors" aria-pressed="false">EN</button>
</div>

<style>
  .lang-btn { color: var(--color-tinta-suave); }
  .lang-btn:hover { color: var(--color-tinta); }
  .lang-btn.lang-active {
    background: var(--color-rosa);
    color: var(--color-rosa-ink);
  }
</style>
