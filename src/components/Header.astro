---
import LangToggle from './LangToggle.astro';
import { getDict, DEFAULT_LANG, type Lang } from '../i18n';
import { SITE } from '../data/site';
interface Props { lang?: Lang; path?: string }
const { lang = DEFAULT_LANG, path = '/' } = Astro.props;
const d = getDict(lang);
const links = [
  { href: '/quien-soy/', key: 'nav.quienSoy', label: d.nav.quienSoy },
  { href: '/por-que-contratarme/', key: 'nav.contratarme', label: d.nav.contratarme },
  { href: '/entrevistas/', key: 'nav.entrevistas', label: d.nav.entrevistas },
  { href: '/logros/', key: 'nav.logros', label: d.nav.logros },
  { href: '/estadisticas/', key: 'nav.estadisticas', label: d.nav.estadisticas },
];
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const isActive = (href: string) => norm(path) === norm(href);
---
<header class="sticky top-0 z-40 border-b border-tinta/10 bg-hueso/90 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:h-[72px]">
    <a href="/" class="font-display text-lg font-bold tracking-tight text-tinta whitespace-nowrap sm:text-xl" aria-label={`${SITE.nombre}, inicio`}>
      Lina Marcela <span class="text-rosa-ink">Pérez</span>
    </a>

    <ul class="hidden items-center gap-7 text-[0.92rem] font-semibold text-tinta-suave lg:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class={`link-ed whitespace-nowrap transition-colors hover:text-tinta ${isActive(l.href) ? 'text-tinta !bg-[length:100%_1.5px]' : ''}`}
            aria-current={isActive(l.href) ? 'page' : undefined}
            data-i18n={l.key}
          >{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <LangToggle />
      <a
        href={SITE.cvEs}
        target="_blank"
        rel="noopener"
        class="btn btn-primary hidden !px-4 !py-2.5 text-sm xl:inline-flex"
        data-i18n="nav.cv"
        data-i18n-attr="href:hero.cvUrl"
      >{d.nav.cv}</a>

      <details class="group relative lg:hidden">
        <summary
          class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full border border-tinta/20 text-tinta transition-colors hover:bg-rosa [&::-webkit-details-marker]:hidden"
          aria-label={d.nav.menu}
          data-i18n-attr="aria-label:nav.menu"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="group-open:hidden">
            <path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round" />
          </svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="hidden group-open:block">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="fixed inset-x-0 top-16 border-b border-tinta/10 bg-rosa px-4 pb-6 pt-2 shadow-[var(--shadow-rosa)] sm:px-6">
          <ul class="mx-auto flex max-w-7xl flex-col">
            {links.map((l) => (
              <li class="border-b border-tinta/10 last:border-0">
                <a
                  href={l.href}
                  class={`flex items-center justify-between py-4 font-display text-2xl font-bold tracking-tight ${isActive(l.href) ? 'text-rosa-ink' : 'text-tinta'}`}
                  aria-current={isActive(l.href) ? 'page' : undefined}
                >
                  <span data-i18n={l.key}>{l.label}</span>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </li>
            ))}
          </ul>
          <a
            href={SITE.cvEs}
            target="_blank"
            rel="noopener"
            class="btn btn-primary mx-auto mt-4 flex w-full max-w-7xl"
            data-i18n="nav.cv"
            data-i18n-attr="href:hero.cvUrl"
          >{d.nav.cv}</a>
        </div>
      </details>
    </div>
  </nav>
</header>
