---
import { SITE } from '../data/site';
/** Iconos de redes: Instagram, TikTok, WhatsApp. */
interface Props {
  size?: number;
  class?: string;
  tone?: 'tinta' | 'hueso';
}
const { size = 20, class: cls = '', tone = 'tinta' } = Astro.props;
const toneCls = tone === 'hueso' ? 'text-hueso border-hueso/30 hover:bg-hueso hover:text-tinta' : 'text-tinta border-tinta/20 hover:bg-rosa';
const links = [
  { href: SITE.instagramUrl, label: `Instagram ${SITE.instagramHandle}`, icon: 'ig' },
  { href: SITE.tiktokUrl, label: `TikTok ${SITE.tiktokHandle}`, icon: 'tt' },
  { href: SITE.whatsappUrl, label: `WhatsApp ${SITE.whatsappNumero}`, icon: 'wa' },
];
---
<ul class={`flex items-center gap-3 ${cls}`}>
  {links.map((l) => (
    <li>
      <a
        href={l.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={l.label}
        class={`grid h-11 w-11 place-items-center rounded-full border ${toneCls} transition-[transform,background-color,color] duration-300 hover:-translate-y-0.5`}
      >
        {l.icon === 'ig' && (
          <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        )}
        {l.icon === 'tt' && (
          <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16.5 3c.3 2 1.6 3.6 3.5 3.9v2.5c-1.3.1-2.6-.3-3.7-1v5.9c0 3.2-2.6 5.7-5.8 5.4A5.4 5.4 0 0 1 5.6 14a5.4 5.4 0 0 1 6.3-4.6v2.7a2.7 2.7 0 1 0 1.9 2.6V3h2.7Z" />
          </svg>
        )}
        {l.icon === 'wa' && (
          <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.33 4.97L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm4.52 11.86c-.25.7-1.24 1.23-1.72 1.3-.44.06-.98.09-1.57-.1-.36-.11-.82-.26-1.41-.52-2.48-1.07-4.11-3.57-4.23-3.74-.12-.16-1.01-1.34-1.01-2.56 0-1.22.63-1.82.86-2.07.23-.25.49-.31.66-.31l.48.01c.15.01.36-.05.56.43.2.5.7 1.72.76 1.84.06.12.1.26.02.43-.08.16-.12.27-.25.41-.12.14-.26.32-.37.43-.12.13-.25.26-.11.51.15.25.64 1.06 1.38 1.72.94.84 1.74 1.11 1.99 1.23.25.13.4.11.54-.06.15-.16.63-.72.79-.97.17-.25.33-.21.56-.13.22.09 1.44.69 1.69.81.25.12.41.18.47.28.07.11.07.6-.14 1.18Z" />
          </svg>
        )}
      </a>
    </li>
  ))}
</ul>
