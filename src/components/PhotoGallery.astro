---
type Item = { tipo: string; src: string; titulo: string };
/** Galería masonry responsive para fotos (image/). */
interface Props {
  items: Item[];
  altBase?: string;
}
const { items, altBase = 'Lina Marcela Pérez con artistas y en cobertura' } = Astro.props;
---
<div class="gallery columns-2 gap-4 sm:columns-3 lg:columns-4 [&>*]:mb-4" data-reveal-group>
  {items.map((it, i) => (
    <figure
      class="group relative break-inside-avoid overflow-hidden rounded-2xl bg-blush-2 shadow-[var(--shadow-soft)] ring-1 ring-black/5"
      data-reveal
    >
      <img
        src={it.src}
        alt={it.titulo || `${altBase} (${i + 1})`}
        loading="lazy"
        decoding="async"
        class="w-full transition-transform duration-500 ease-out group-hover:scale-[1.04]"
      />
      <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-carbon/0 to-carbon/0 transition-colors duration-300 group-hover:from-carbon/25"></span>
    </figure>
  ))}
</div>
