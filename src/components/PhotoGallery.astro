---
import { url, type MediaItem } from '../data/media';
/** Fotos con artistas como polaroids en duotono rosa: ligeramente giradas,
 *  se enderezan y recuperan el color al pasar el cursor. */
interface Props {
  items: MediaItem[];
  altBase?: string;
}
const { items, altBase = 'Lina Marcela Pérez con artistas y en cobertura' } = Astro.props;
const rots = ['-2.5deg', '1.8deg', '-1.2deg', '2.6deg', '-1.8deg', '1.2deg'];
---
<div class="columns-2 gap-5 sm:columns-3 lg:columns-4 [&>*]:mb-6" data-reveal-group>
  {items.map((it, i) => (
    <figure class="polaroid relative break-inside-avoid bg-hueso p-2.5 pb-8 shadow-[var(--shadow-soft)] ring-1 ring-tinta/5" style={`--rot:${rots[i % rots.length]}`} data-reveal tabindex="0">
      <div class="duo">
        <img
          src={url(it.src)}
          alt={it.titulo || `${altBase} (${i + 1})`}
          loading="lazy"
          decoding="async"
          class="block w-full"
        />
      </div>
    </figure>
  ))}
</div>
