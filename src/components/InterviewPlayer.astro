---
/** "Sala de edición": un reproductor grande + lista de entrevistas.
 *  Elegir un título carga ese video en el reproductor (ver scripts/player.ts). */
import { url, type MediaItem } from '../data/media';
import { getDict, DEFAULT_LANG, type Lang } from '../i18n';
interface Props { items: (MediaItem & { i18nIndex: number })[]; lang?: Lang }
const { items, lang = DEFAULT_LANG } = Astro.props;
const d = getDict(lang);
const first = items[0];
const src = (s: string) => `${url(s)}#t=0.1`;
---
{first && (
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12" data-player>
    <div class="lg:col-span-5" data-reveal>
      <div class="duo relative mx-auto aspect-[9/16] max-h-[70svh] w-[min(78vw,320px)] sm:w-full sm:max-w-[420px] lg:max-h-[78dvh] shadow-[var(--shadow-rosa)]" data-player-frame>
        <video
          class="h-full w-full object-contain"
          src={src(first.src)}
          preload="metadata"
          playsinline
          controls
          data-player-video
          aria-label={d.destacadas.items[first.i18nIndex]}
        ></video>
      </div>
    </div>
    <ol class="flex flex-col lg:col-span-7" data-reveal-group>
      {items.map((it, i) => (
        <li class="border-b border-tinta/15 first:border-t" data-reveal>
          <button
            type="button"
            class="cue group grid w-full grid-cols-[auto_1fr_auto] items-center gap-3 px-2 py-4 sm:gap-5 sm:px-3 sm:py-5 text-left transition-colors hover:bg-rosa-soft"
            data-cue={src(it.src)}
            aria-current={i === 0 ? 'true' : 'false'}
          >
            <span class="cue-num font-display text-2xl sm:text-3xl font-extrabold text-tinta/30 [font-variation-settings:'wdth'_75] transition-colors group-hover:text-rosa-ink" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="display-md !text-[clamp(1.15rem,4.6vw,2.1rem)] text-tinta" data-i18n={`destacadas.items.${it.i18nIndex}`}>{d.destacadas.items[it.i18nIndex]}</span>
            <span class="grid h-11 w-11 place-items-center rounded-full border border-tinta/25 text-tinta transition-colors group-hover:bg-tinta group-hover:text-hueso" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </button>
        </li>
      ))}
    </ol>
  </div>
)}
