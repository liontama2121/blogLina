---
import SocialLinks from './SocialLinks.astro';
import { SITE } from '../data/site';
import { getDict, DEFAULT_LANG, type Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = DEFAULT_LANG } = Astro.props;
const d = getDict(lang);
const year = new Date().getFullYear();
---
<footer class="border-t border-tinta/10 bg-hueso">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-display text-xl font-bold tracking-tight">Lina Marcela <span class="text-rosa-ink">Pérez</span></p>
      <p class="mt-1 text-sm text-tinta-suave">© {year} {SITE.nombreCompleto}</p>
    </div>
    <SocialLinks />
    <p class="text-sm text-tinta-suave" data-i18n="footer.made">{d.footer.made}</p>
  </div>
</footer>
