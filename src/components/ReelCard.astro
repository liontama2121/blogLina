---
/** Tarjeta de video vertical: muestra el primer frame real y reproduce inline al click.
 *  Sin recorte: el video se ve completo (object-contain) sobre fondo oscuro neutro. */
interface Props {
  src: string;
  poster?: string;
  titulo?: string;
  badge?: string;       // texto del badge (ej: "EN VIVO")
  ratio?: string;       // "9:16" | "1:1" | "16:9"
  live?: boolean;       // muestra badge LIVE animado
}
const { src, poster = '', titulo = '', badge, ratio = '9:16', live = false } = Astro.props;
const aspect = ratio === '1:1' ? 'aspect-square' : ratio === '16:9' ? 'aspect-video' : 'aspect-[9/16]';
const label = titulo ? `Reproducir: ${titulo}` : 'Reproducir video';
// Sin poster: cargamos metadata y forzamos el primer frame con #t (en vez del fondo rosado).
const videoSrc = poster ? src : `${src}#t=0.1`;
---
<figure
  class={`reel group relative ${aspect} overflow-hidden rounded-2xl bg-[#17120f] shadow-[var(--shadow-card)] ring-1 ring-black/10`}
  data-reel
  data-reveal
>
  <video
    class="reel-video h-full w-full object-contain"
    src={videoSrc}
    poster={poster || undefined}
    preload="metadata"
    playsinline
    muted
    loop
    aria-label={label}
  ></video>

  <!-- Overlay play (translúcido, deja ver el frame) -->
  <button
    type="button"
    class="reel-play absolute inset-0 flex items-center justify-center transition-opacity duration-300"
    aria-label={label}
    data-i18n-attr="aria-label:reel.play"
  >
    <span class="absolute inset-0 bg-black/10 transition-colors duration-300 group-hover:bg-black/25"></span>
    <span
      class="relative grid h-16 w-16 place-items-center rounded-full bg-white/85 text-rosa shadow-lg backdrop-blur-sm transition-transform duration-300 group-hover:scale-110"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7z" />
      </svg>
    </span>
  </button>

  {(badge || live) && (
    <span class="absolute left-3 top-3 z-10">
      {live ? (
        <span class="badge-live" data-i18n="reel.live">EN VIVO</span>
      ) : (
        <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-carbon">{badge}</span>
      )}
    </span>
  )}

  {titulo && (
    <figcaption
      class="pointer-events-none absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/75 to-transparent p-3 text-sm font-medium text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    >{titulo}</figcaption>
  )}
</figure>
