---
/** Video vertical: muestra el primer frame real y reproduce inline al click (ver scripts/reel.ts).
 *  El video se ve completo (object-contain) sobre tinta; el título va debajo, como pie de foto. */
import { url, cleanTitle } from '../data/media';
interface Props {
  src: string;
  poster?: string;
  titulo?: string;
  tituloKey?: string;   // clave i18n si el título viene traducido
  ratio?: string;       // "9:16" | "1:1" | "16:9"
  live?: boolean;       // badge EN VIVO (estado real de la pieza)
  caption?: boolean;    // mostrar pie de foto
  class?: string;
}
const { src, poster = '', titulo = '', tituloKey, ratio = '9:16', live = false, caption = true, class: cls = '' } = Astro.props;
const aspect = ratio === '1:1' ? 'aspect-square' : ratio === '16:9' ? 'aspect-video' : 'aspect-[9/16]';
const title = cleanTitle(titulo);
// Sin poster: forzamos el primer frame con #t.
const videoSrc = poster ? url(src) : `${url(src)}#t=0.1`;
---
<figure class={`group flex flex-col gap-3 ${cls}`} data-reveal>
  <div class={`reel duo relative ${aspect}`} data-reel>
    <video
      class="reel-video h-full w-full object-contain"
      src={videoSrc}
      poster={poster ? url(poster) : undefined}
      preload="metadata"
      playsinline
      muted
      loop
      aria-label={title || 'Video'}
    ></video>

    <button
      type="button"
      class="reel-play absolute inset-0 z-10 flex items-end justify-start p-3 sm:p-4 transition-opacity duration-300"
      aria-label="Reproducir video"
      data-i18n-attr="aria-label:reel.play"
    >
      <span class="absolute inset-0 bg-gradient-to-t from-tinta/45 via-transparent to-transparent transition-opacity duration-300 group-hover:opacity-70"></span>
      <span class="relative grid h-10 w-10 place-items-center rounded-full bg-rosa sm:h-12 sm:w-12 text-tinta transition-transform duration-300 group-hover:scale-110">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      </span>
    </button>

    {live && (
      <span class="absolute left-3 top-3 z-20"><span class="badge-live" data-i18n="reel.live">EN VIVO</span></span>
    )}
  </div>

  {caption && title && (
    <figcaption
      class="line-clamp-2 text-sm font-semibold leading-snug text-tinta sm:text-[0.95rem]"
      {...(tituloKey ? { 'data-i18n': tituloKey } : {})}
    >{title}</figcaption>
  )}
</figure>
