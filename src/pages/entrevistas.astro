---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageMasthead from '../components/PageMasthead.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ReelCard from '../components/ReelCard.astro';
import InterviewPlayer from '../components/InterviewPlayer.astro';
import MediaGrid from '../components/MediaGrid.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { getDict, DEFAULT_LANG } from '../i18n';
import { byTipo, destacadas, restoEntrevistas } from '../data/media';
const lang = DEFAULT_LANG;
const d = getDict(lang);
const featured = destacadas();
const resto = restoEntrevistas();
const campoVideo = byTipo('video');
const fotos = byTipo('image');
---
<BaseLayout lang={lang} title={d.nav.entrevistas} description={d.periodista.text}>
  <PageMasthead title={d.nav.entrevistas} titleKey="nav.entrevistas" lead={d.periodista.text} leadKey="periodista.text" field="hueso" />

  <!-- Periodista: destacadas con título + resto -->
  <section class="bg-hueso">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-24">
      <SectionTitle i18nKey="periodista.title" text={d.periodista.title} />
      <div class="mt-12"><InterviewPlayer items={featured} lang={lang} /></div>
      {resto.length > 0 && (
        <div class="mt-16 grid grid-cols-2 gap-x-3 gap-y-8 sm:grid-cols-3 sm:gap-x-6 sm:gap-y-10 lg:mt-20 lg:grid-cols-4" data-reveal-group>
          {resto.map((it) => (
            <ReelCard src={it.src} poster={it.poster} titulo={it.titulo} ratio={it.ratio} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Campo -->
  <section class="bg-rosa-soft">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-24">
      <SectionTitle i18nKey="campo.title" text={d.campo.title} lead={d.campo.text} leadKey="campo.text" />
      <div class="mt-12">
        <MediaGrid items={campoVideo} live={true} emptyText={d.campo.empty} emptyKey="campo.empty" />
      </div>
    </div>
  </section>

  <!-- Con artistas (fotos) -->
  <section class="bg-hueso">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-24">
      <SectionTitle i18nKey="entrevistas.title" text={d.entrevistas.title} lead={d.entrevistas.text} leadKey="entrevistas.text" />
      <div class="mt-12"><PhotoGallery items={fotos} /></div>
    </div>
  </section>
</BaseLayout>
