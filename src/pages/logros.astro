---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageMasthead from '../components/PageMasthead.astro';
import SectionTitle from '../components/SectionTitle.astro';
import MediaLogoCard from '../components/MediaLogoCard.astro';
import { getDict, DEFAULT_LANG } from '../i18n';
import { mediosConLogo } from '../data/media';
const lang = DEFAULT_LANG;
const d = getDict(lang);
const medios = mediosConLogo().filter((m) => m.logoSrc || !m.placeholder);
const tones = ['rosa', 'hueso', 'hueso-2', 'hueso'] as const;
const items: string[] = d.logros.items;
---
<BaseLayout lang={lang} title={d.logros.title} description={d.logros.text}>
  <PageMasthead title={d.logros.title} titleKey="logros.title" lead={d.logros.text} leadKey="logros.text" field="rosa" />

  <!-- Medios -->
  <section class="bg-hueso">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-24">
      <SectionTitle i18nKey="logros.mediosTitle" text={d.logros.mediosTitle} />
      <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-12 lg:grid-cols-4" data-reveal-group>
        {medios.map((m, i) => (
          <MediaLogoCard
            nombre={m.nombre}
            url={m.url}
            logoSrc={m.logoSrc}
            ctaText={d.logros.verPerfil}
            ctaKey="logros.verPerfil"
            pendingText={d.logros.pendiente}
            pendingKey="logros.pendiente"
            placeholder={m.placeholder}
            tone={tones[i % tones.length]}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Hitos: dos columnas, número grande como marcador editorial -->
  <section class="bg-hueso-2">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:py-28">
      <h2 class="display-lg text-tinta lg:col-span-4" data-reveal data-i18n="logros.highlightsTitle">{d.logros.highlightsTitle}</h2>
      <ol class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:col-span-8" data-reveal-group>
        {items.map((it, i) => (
          <li class="flex flex-col gap-3 border-t-2 border-tinta pt-5" data-reveal>
            <span class="font-display text-4xl font-bold text-rosa-ink" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-lg leading-relaxed text-tinta" data-i18n={`logros.items.${i}`}>{it}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
