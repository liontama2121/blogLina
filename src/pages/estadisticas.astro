---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageMasthead from '../components/PageMasthead.astro';
import SectionTitle from '../components/SectionTitle.astro';
import MediaGrid from '../components/MediaGrid.astro';
import { getDict, DEFAULT_LANG } from '../i18n';
import { STATS, SITE } from '../data/site';
import { byTipo } from '../data/media';
const lang = DEFAULT_LANG;
const d = getDict(lang);
const L = d.estadisticas.labels;
const tiktoks = byTipo('tiktok');

type Stat = { k: keyof typeof L; value: string };
const grupos = [
  {
    nombre: 'TikTok',
    handle: `@${STATS.tiktok.handle}`,
    href: SITE.tiktokUrl,
    stats: [
      { k: 'seguidores', value: STATS.tiktok.seguidores },
      { k: 'likes', value: STATS.tiktok.likes },
      { k: 'vistas', value: STATS.tiktok.vistas_promedio },
      { k: 'engagement', value: STATS.tiktok.engagement },
    ] as Stat[],
  },
  {
    nombre: 'Instagram',
    handle: `@${STATS.instagram.handle}`,
    href: SITE.instagramUrl,
    stats: [
      { k: 'seguidores', value: STATS.instagram.seguidores },
      { k: 'alcance', value: STATS.instagram.alcance_mensual },
      { k: 'engagement', value: STATS.instagram.engagement },
    ] as Stat[],
  },
  {
    nombre: L.audiencia,
    nombreKey: 'estadisticas.labels.audiencia',
    stats: [
      { k: 'edad', value: STATS.audiencia.edad_principal },
      { k: 'genero', value: STATS.audiencia.genero },
      { k: 'ciudades', value: STATS.audiencia.ciudades },
    ] as Stat[],
  },
];
const filled = (s: Stat[]) => s.filter((x) => x.value);
const pending = (s: Stat[]) => s.filter((x) => !x.value);
const fields = ['bg-rosa', 'bg-hueso ring-1 ring-tinta/10', 'bg-hueso-2'];
---
<BaseLayout lang={lang} title={d.estadisticas.title} description={d.estadisticas.text}>
  <PageMasthead title={d.estadisticas.title} titleKey="estadisticas.title" lead={d.estadisticas.text} leadKey="estadisticas.text" field="rosa" />

  <section class="bg-hueso">
    <div class="mx-auto grid max-w-7xl gap-4 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:py-24" data-reveal-group>
      {grupos.map((g, gi) => (
        <article class={`flex flex-col gap-8 p-7 lg:p-10 ${fields[gi]} ${gi === 0 ? 'lg:col-span-12' : 'lg:col-span-6'}`} data-reveal>
          <header class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="display-md text-tinta" {...(g.nombreKey ? { 'data-i18n': g.nombreKey } : {})}>{g.nombre}</h2>
            {g.href && (
              <a href={g.href} target="_blank" rel="noopener noreferrer" class="link-ed font-bold text-rosa-ink">{g.handle}</a>
            )}
          </header>

          {filled(g.stats).length > 0 && (
            <dl class="grid grid-cols-2 gap-6 sm:gap-10">
              {filled(g.stats).map((s) => (
                <div class="flex flex-col gap-1">
                  <dt class="order-2 font-semibold text-tinta-suave" data-i18n={`estadisticas.labels.${s.k}`}>{L[s.k]}</dt>
                  <dd class="order-1 font-display text-6xl font-bold tracking-tight text-tinta sm:text-8xl">{s.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {pending(g.stats).length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {pending(g.stats).map((s) => (
                <li class="inline-flex items-center gap-2 rounded-full border border-tinta/15 px-4 py-2 text-sm">
                  <span class="font-semibold text-tinta" data-i18n={`estadisticas.labels.${s.k}`}>{L[s.k]}</span>
                  <span class="text-tinta-suave" data-i18n="estadisticas.pendiente">{d.estadisticas.pendiente}</span>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
      <p class="text-sm text-tinta-suave lg:col-span-12" data-reveal data-i18n="estadisticas.nota">{d.estadisticas.nota}</p>
    </div>
  </section>

  <section class="bg-rosa-soft">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-24">
      <SectionTitle i18nKey="redes.title" text={d.redes.title} lead={d.redes.text} leadKey="redes.text" />
      <div class="mt-12"><MediaGrid items={tiktoks} /></div>
    </div>
  </section>
</BaseLayout>
