---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getDict, DEFAULT_LANG } from '../i18n';
const lang = DEFAULT_LANG;
const d = getDict(lang);
const HERO_IMAGE = '/media/image/463824637_18463612693060418_5005392328436031798_n..jpg';
---
<BaseLayout lang={lang} title={d.nav.quienSoy} description={d.perfil.bio}>
  <section class="bg-crema">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="relative mx-auto w-full max-w-sm" data-reveal>
        <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-tr from-rosa/30 via-blush to-coral/20 blur-xl"></div>
        <img
          src={HERO_IMAGE}
          alt="Retrato de Lina Marcela Pérez"
          class="relative aspect-[4/5] w-full rounded-[2rem] object-cover ring-1 ring-dorado/30 shadow-[var(--shadow-card)]"
          loading="eager"
        />
      </div>
      <div class="flex flex-col gap-6">
        <SectionTitle i18nKey="perfil.title" text={d.perfil.title} />
        <span class="pill pill-outline w-fit !py-1.5 text-xs" data-reveal>
          <span class="inline-block h-2 w-2 rounded-full bg-salvia"></span>
          <span data-i18n="hero.badge">{d.hero.badge}</span>
        </span>
        <p class="text-lg leading-relaxed text-carbon/90" data-reveal data-i18n="perfil.bio">{d.perfil.bio}</p>
        <div data-reveal><SocialLinks /></div>
      </div>
    </div>
  </section>
</BaseLayout>
