---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageMasthead from '../components/PageMasthead.astro';
import ContactClose from '../components/ContactClose.astro';
import { getDict, DEFAULT_LANG } from '../i18n';
import { PHOTOS } from '../data/site';
import { url } from '../data/media';
const lang = DEFAULT_LANG;
const d = getDict(lang);

// 5 servicios → bento 5 celdas: fila 1 = 2 (ancha + foto), fila 2 = 3.
const servicios = [
  { k: 'host', cls: 'md:col-span-4 bg-rosa-deep', big: true },
  { k: 'entrevistas', cls: 'md:col-span-2 bg-tinta text-hueso', big: false },
  { k: 'ugc', cls: 'md:col-span-2 bg-hueso-2', big: false },
  { k: 'redaccion', cls: 'md:col-span-2 bg-hueso ring-1 ring-tinta/10', big: false },
  { k: 'redes', cls: 'md:col-span-2 bg-rosa-soft', big: false },
] as const;
---
<BaseLayout lang={lang} title={d.marcas.title} description={d.marcas.text}>
  <PageMasthead title={d.marcas.title} titleKey="marcas.title" lead={d.marcas.text} leadKey="marcas.text" field="rosa" />

  <section class="bg-hueso">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
      <h2 class="display-lg text-tinta" data-reveal data-i18n="marcas.serviciosTitle">{d.marcas.serviciosTitle}</h2>
      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-6" data-reveal-group>
        {servicios.map((s) => (
          <article class={`flex flex-col justify-end gap-3 p-6 md:min-h-[220px] lg:p-9 ${s.cls} ${s.big ? 'md:min-h-[320px]' : ''}`} data-reveal>
            {s.k === 'entrevistas' && (
              <div class="duo mb-auto aspect-[4/3] w-full"><img src={url(PHOTOS.evento)} alt="" loading="lazy" class="h-full w-full object-cover" /></div>
            )}
            <h3 class={`${s.big ? 'display-lg' : 'display-md'}`} data-i18n={`marcas.servicios.${s.k}.t`}>{d.marcas.servicios[s.k].t}</h3>
            <p class={`max-w-[48ch] ${s.k === 'entrevistas' ? 'text-hueso/80' : 'text-tinta-suave'}`} data-i18n={`marcas.servicios.${s.k}.d`}>{d.marcas.servicios[s.k].d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactClose lang={lang} field="hueso" />
</BaseLayout>
