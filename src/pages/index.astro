---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Squiggle from '../components/Squiggle.astro';
import { getDict, DEFAULT_LANG } from '../i18n';
import { SITE } from '../data/site';

const lang = DEFAULT_LANG;
const d = getDict(lang);

// PLACEHOLDER — foto de portada del hero (poster del video / fallback).
const HERO_IMAGE = '/media/image/463824637_18463612693060418_5005392328436031798_n..jpg';
// Video de portada (loop, sin sonido).
const HERO_VIDEO = '/media/hero.mp4';

const cards = [
  { href: '/quien-soy/', key: 'home.cards.quienSoy', navKey: 'nav.quienSoy', label: d.nav.quienSoy, text: d.home.cards.quienSoy },
  { href: '/por-que-contratarme/', key: 'home.cards.contratarme', navKey: 'nav.contratarme', label: d.nav.contratarme, text: d.home.cards.contratarme },
  { href: '/entrevistas/', key: 'home.cards.entrevistas', navKey: 'nav.entrevistas', label: d.nav.entrevistas, text: d.home.cards.entrevistas },
  { href: '/logros/', key: 'home.cards.logros', navKey: 'nav.logros', label: d.nav.logros, text: d.home.cards.logros },
  { href: '/estadisticas/', key: 'home.cards.estadisticas', navKey: 'nav.estadisticas', label: d.nav.estadisticas, text: d.home.cards.estadisticas },
];
---
<BaseLayout lang={lang}>
  <!-- HERO -->
  <section class="relative overflow-hidden" data-hero>
    <div class="pointer-events-none absolute -right-20 -top-24 h-80 w-80 rounded-full bg-blush blur-3xl opacity-70"></div>
    <div class="pointer-events-none absolute -left-24 top-40 h-72 w-72 rounded-full bg-salvia/20 blur-3xl"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2 lg:gap-16 lg:py-28">
      <div class="flex flex-col items-start gap-6">
        <span class="pill pill-outline !py-1.5 text-xs" data-hero-item>
          <span class="inline-block h-2 w-2 rounded-full bg-salvia"></span>
          <span data-i18n="hero.badge">{d.hero.badge}</span>
        </span>
        <h1 class="font-display text-5xl leading-[0.95] text-carbon sm:text-6xl lg:text-7xl" data-hero-item>
          Lina <span class="italic text-rosa">Marcela</span>
        </h1>
        <p class="max-w-md text-lg text-gris-suave" data-hero-item data-i18n="hero.role">{d.hero.role}</p>
        <p class="max-w-lg text-base text-carbon/80" data-hero-item data-i18n="home.intro">{d.home.intro}</p>
        <div class="flex flex-wrap items-center gap-3" data-hero-item>
          <a href="/por-que-contratarme/" class="pill pill-solid" data-i18n="nav.contratarme">{d.nav.contratarme}</a>
          <a
            href={SITE.cvEs}
            target="_blank"
            rel="noopener"
            class="pill pill-outline"
            data-i18n="hero.ctaKit"
            data-i18n-attr="href:hero.cvUrl"
          >{d.hero.ctaKit}</a>
        </div>
        <div data-hero-item><SocialLinks /></div>
      </div>

      <div class="relative mx-auto w-full max-w-sm" data-hero-item>
        <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-tr from-rosa/30 via-blush to-coral/20 blur-xl"></div>
        <div class="relative overflow-hidden rounded-[2rem] bg-[#17120f] ring-1 ring-dorado/30 shadow-[var(--shadow-card)]">
          <video
            src={HERO_VIDEO}
            poster={HERO_IMAGE}
            class="aspect-[9/16] w-full object-contain"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Video de presentación de Lina Marcela Pérez"
          ></video>
        </div>
        <div class="float-heart absolute -right-3 -top-3 text-coral">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.7-9C.9 9.2 2.3 6 5.3 6c1.8 0 3 .9 3.7 2 .7-1.1 1.9-2 3.7-2 3 0 4.4 3.2 3 6-2.2 4.4-9.7 9-9.7 9Z"/></svg>
        </div>
      </div>
    </div>
    <div class="mx-auto max-w-7xl px-6"><div class="hairline"></div></div>
  </section>

  <!-- EXPLORA (cards a páginas) -->
  <section class="bg-crema">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <div class="flex flex-col items-center gap-3 text-center" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-salvia" data-i18n="home.explorar">{d.home.explorar}</span>
        <Squiggle variant="underline" width="150" />
      </div>
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {cards.map((c) => (
          <a
            href={c.href}
            class="reel group flex flex-col gap-3 rounded-3xl border border-dorado/30 bg-white/60 p-7 shadow-[var(--shadow-soft)]"
            data-reveal
          >
            <h2 class="font-display text-2xl italic text-rosa" data-i18n={c.navKey}>{c.label}</h2>
            <p class="text-gris-suave" data-i18n={c.key}>{c.text}</p>
            <span class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-coral">
              <span data-i18n="home.ver">{d.home.ver}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
