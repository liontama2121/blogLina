---
import BaseLayout from '../layouts/BaseLayout.astro';
import InterviewPlayer from '../components/InterviewPlayer.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import ContactClose from '../components/ContactClose.astro';
import { getDict, DEFAULT_LANG } from '../i18n';
import { SITE, PHOTOS, STATS, MEDIOS } from '../data/site';
import { url, destacadas, mediosConLogo, fotosArtistas } from '../data/media';

const lang = DEFAULT_LANG;
const d = getDict(lang);

const HERO_VIDEO = '/media/hero.mp4';
const featured = destacadas();
const logos = mediosConLogo().filter((m) => m.logoSrc);
const fotos = fotosArtistas();

// Solo datos reales (site.ts). Medios = cantidad de MEDIOS listados.
const numeros = [
  { valor: STATS.tiktok.seguidores, key: 'numeros.seguidores', label: d.numeros.seguidores },
  { valor: STATS.tiktok.likes, key: 'numeros.likes', label: d.numeros.likes },
  { valor: String(MEDIOS.length), key: 'numeros.medios', label: d.numeros.medios },
  { valor: 'C1', key: 'numeros.ingles', label: d.numeros.ingles },
];

const indice = [
  { href: '/quien-soy/', key: 'nav.quienSoy', label: d.nav.quienSoy, dKey: 'home.cards.quienSoy', desc: d.home.cards.quienSoy },
  { href: '/por-que-contratarme/', key: 'nav.contratarme', label: d.nav.contratarme, dKey: 'home.cards.contratarme', desc: d.home.cards.contratarme },
  { href: '/entrevistas/', key: 'nav.entrevistas', label: d.nav.entrevistas, dKey: 'home.cards.entrevistas', desc: d.home.cards.entrevistas },
  { href: '/logros/', key: 'nav.logros', label: d.nav.logros, dKey: 'home.cards.logros', desc: d.home.cards.logros },
  { href: '/estadisticas/', key: 'nav.estadisticas', label: d.nav.estadisticas, dKey: 'home.cards.estadisticas', desc: d.home.cards.estadisticas },
];
const arrow = 'M5 12h14M13 6l6 6-6 6';
---
<BaseLayout lang={lang}>
  <!-- PORTADA: rosa total, nombre condensado gigante + video en polaroid duotono -->
  <section class="relative overflow-hidden bg-rosa" data-hero>
    <div class="mx-auto grid max-w-7xl gap-12 px-4 pb-14 pt-8 sm:px-6 lg:min-h-[min(calc(100dvh-72px),900px)] lg:grid-cols-12 lg:items-center lg:gap-8 lg:pb-14 lg:pt-8">
      <div class="lg:col-span-8">
        <h1 class="display-mega text-tinta !text-[clamp(4.5rem,13.5vw,13.5rem)]" data-hero-item>
          Lina<br />Marcela<br /><span class="text-rosa-ink">Pérez</span>
        </h1>
        <p class="lead mt-8 !text-tinta/80" data-hero-item data-i18n="hero.sub">{d.hero.sub}</p>
        <div class="mt-8 flex flex-wrap gap-3" data-hero-item>
          <a href="#entrevistas" class="btn btn-primary">
            <span data-i18n="hero.ctaPrimary">{d.hero.ctaPrimary}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={arrow} stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href={SITE.cvEs} target="_blank" rel="noopener" class="btn btn-ghost" data-i18n="hero.ctaCv" data-i18n-attr="href:hero.cvUrl">{d.hero.ctaCv}</a>
        </div>
      </div>

      <div class="lg:col-span-4" data-hero-item>
        <div class="polaroid mx-auto w-[min(64vw,260px)] sm:w-[min(50vw,320px)] bg-hueso p-3 pb-12 shadow-[var(--shadow-rosa)] lg:w-full lg:max-w-[340px]" style="--rot:4deg">
          <div class="duo aspect-[9/16]">
            <video
              src={HERO_VIDEO}
              poster={url(PHOTOS.hero)}
              class="h-full w-full object-cover"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              data-hero-video
              aria-label={d.hero.videoLabel}
              data-i18n-attr="aria-label:hero.videoLabel"
            ></video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MEDIOS: única marquesina de la página -->
  <section class="border-y border-tinta/10 bg-hueso-2 py-7" aria-label={d.home.medios}>
    <div class="marquee">
      <div class="marquee-track">
        {[0, 1].map((dup) => (
          <ul class="flex shrink-0 items-center gap-20 pr-20" aria-hidden={dup === 1 ? 'true' : undefined}>
            {[...logos, ...logos].map((m) => (
              <li class="flex h-14 items-center">
                <img src={m.logoSrc} alt={dup === 0 ? m.nombre : ''} loading="lazy" class="max-h-12 w-auto max-w-[150px] object-contain mix-blend-multiply grayscale contrast-125" />
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- ENTREVISTAS: sala de edición -->
  <section id="entrevistas" class="scroll-mt-20 bg-hueso">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
      <div class="mb-12 flex flex-col gap-5 md:flex-row md:items-end md:justify-between" data-reveal>
        <h2 class="display-xl max-w-3xl text-tinta" data-i18n="home.destacadasTitle">{d.home.destacadasTitle}</h2>
        <a href="/entrevistas/" class="link-ed inline-flex w-fit shrink-0 items-center gap-2 font-bold text-rosa-ink">
          <span data-i18n="home.verTodas">{d.home.verTodas}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={arrow} stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <InterviewPlayer items={featured} lang={lang} />
    </div>
  </section>

  <!-- NÚMEROS reales -->
  <section class="bg-tinta text-hueso">
    <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-12 px-4 py-16 sm:px-6 lg:grid-cols-4 lg:py-20" data-reveal-group>
      {numeros.map((n) => (
        <div class="flex flex-col gap-2 border-l-2 border-rosa pl-5" data-reveal>
          <dt class="order-2 font-semibold text-hueso/70" data-i18n={n.key}>{n.label}</dt>
          <dd class="order-1 display-xl text-rosa">{n.valor}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- CON ARTISTAS: polaroids -->
  <section class="bg-rosa-soft">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
      <div class="mb-14 flex flex-col gap-5 md:flex-row md:items-end md:justify-between" data-reveal>
        <h2 class="display-xl text-tinta" data-i18n="artistas.title">{d.artistas.title}</h2>
        <a href="/entrevistas/" class="link-ed inline-flex w-fit shrink-0 items-center gap-2 font-bold text-rosa-ink">
          <span data-i18n="artistas.link">{d.artistas.link}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={arrow} stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <PhotoGallery items={fotos} />
    </div>
  </section>

  <!-- ÍNDICE tipográfico -->
  <nav class="bg-hueso" aria-label="Índice">
    <ul class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-24" data-reveal-group>
      {indice.map((c) => (
        <li class="border-b border-tinta/15" data-reveal>
          <a href={c.href} class="index-link flex flex-col gap-2 py-6 md:flex-row md:items-center md:justify-between md:gap-10">
            <span class="index-word display-xl inline-flex items-center gap-4 text-tinta">
              <span data-i18n={c.key}>{c.label}</span>
              <svg class="index-arrow hidden shrink-0 md:block" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="max-w-xs text-tinta-suave md:text-right" data-i18n={c.dKey}>{c.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <ContactClose lang={lang} />
</BaseLayout>
